# FoodLoop Backend Environment Variables
PROJECT_NAME=FoodLoop
VERSION=1.0.0
API_V1_PREFIX=/api/v1

# Google Cloud & Vertex AI
GCP_PROJECT_ID=foodloop-hackathon
GCP_LOCATION=asia-south1
VERTEX_AI_MODEL_FLASH=gemini-2.5-flash
VERTEX_AI_MODEL_PRO=gemini-1.5-pro

# Firebase & Auth
FIREBASE_PROJECT_ID=foodloop-hackathon
SECRET_KEY=foodloop-development-secret-key-replace-in-production
APP_CHECK_ENABLED=false

# BigQuery Analytics
BIGQUERY_DATASET=foodloop_analytics

# Food Safety & Matching Rules
MATCHING_RADIUS_KM=5.0
FSSAI_MAX_AMBIENT_HOURS=4.0
FSSAI_HIGH_HEAT_MAX_HOURS=2.0
HIGH_HEAT_TEMP_THRESHOLD_C=32.0
